# Reproducible scripts + selected public proof are committed; media shipped as release assets.
videos/**/editorial/*.mp4
videos/**/editorial/*.wav
videos/**/editorial/*-concat.txt
videos/**/editorial/*.cache.json
videos/**/assets/proof/*.mp4
videos/**/assets/proof/*.webm
videos/**/assets/proof/*.mp3
videos/**/reports/*check*.json
videos/**/reports/CLAUDE-HANDOFF*.md
videos/**/reports/encoded-*/
videos/**/reports/*-audio.log
videos/**/.private/
videos/**/reports/*.log
videos/**/frame.md
videos/**/caption-skin.json

# Local render caches and pre-polish timing audit contain workstation paths.
videos/**/editorial/*.audio-cache.json
videos/**/reports/timeline-polish-before.json

# Local Cloudflare state and cached credentials never belong in source.
