# leave empty for two readers over OpenRouter; or astra (Codex CLI), openrouter, gemini, fixture
SNAP_BACKEND=
OPENROUTER_API_KEY=
SNAP_PRIMARY_MODEL=google/gemini-3.8-flash
SNAP_SECOND_MODEL=openai/gpt-6-astra
ASTRA_MODEL=gpt-6-astra
ASTRA_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# MongoDB Atlas; without it snaps and leagues are stored in ./data
MONGODB_URI=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# EasyChamp publishing stays a dry run unless both are set
EC_PUBLISH=0
EC_TOKEN=
# or a command that prints a fresh token each publish
EC_TOKEN_CMD=
EC_OWNER_ID=
EC_API_URL=https://easychamp.com/ec-standings-api
